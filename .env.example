# ==========================================
# PENSION SEVA — ENVIRONMENT TEMPLATE
# Academic Prototype — Civic Welfare Platform
# Copy this file to .env and adjust variables as needed
# ==========================================

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_NAME="Pension Seva Backend API"
APP_VERSION=1.0.0

# Database Configuration (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pension_seva
DB_NAME=pension_seva

# Persistent source-to-decision traceability store and protected document files
TRACEABILITY_DATABASE_URL=sqlite:///./backend/traceability.sqlite3
# Use a stable private Fernet-compatible secret in deployed environments.
DOCUMENT_ENCRYPTION_KEY=

# Security & Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Document Processing & Uploads (10 MB default)
MAX_FILE_SIZE_BYTES=10485760

# Local OCR (Tesseract must be installed on the backend host)
TESSERACT_CMD=
OCR_LANGUAGES=eng

# Optional External AI / Gemini Integration
GEMINI_API_KEY=

# Optional Voice Services
VOICE_SERVICE_PROVIDER=webspeech_native

# OTP verification and email delivery
OTP_PROVIDER=email
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_HOUR=5
# Email delivery is implemented. SMS OTP delivery is unsupported.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=
